NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=...

GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ─── APP ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Food4Love

# Paystack (TEST MODE — replace with live keys before launch)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Waitlist email delivery (server-only secrets)
RESEND_API_KEY=
WAITLIST_FROM_EMAIL="Food4Love <updates@food4love.app>"
WAITLIST_CONFIRMATION_FROM_EMAIL="Food4Love <hello@food4love.app>"
# Optional. Sender for the welcome email after a user confirms their email.
# Falls back to WAITLIST_CONFIRMATION_FROM_EMAIL, then RESEND_FROM_EMAIL.
WELCOME_FROM_EMAIL="Food4Love <hello@food4love.app>"
# Optional. Set to false to switch the post-verification welcome email off.
WELCOME_EMAIL_ENABLED=true
ACCOUNT_UPDATES_FROM_EMAIL="Food4Love <updates@food4love.app>"
# Admin support email delivery (server-only)
RESEND_FROM_EMAIL="Food4Love <contact@food4love.app>"
