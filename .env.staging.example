# STAGING configuration (names only: copy to .env.staging.local, which git ignores, and fill in).
# Used ONLY by `npm run dev:staging` and `npm run preflight:staging`. Next.js never loads this file by itself,
# and the launcher blanks every variable from your normal .env files that is not set here.
#
# EVERYTHING below must come from the STAGING Supabase project and staging-only accounts.
# NEVER paste a production key here. The launcher refuses to start if a key or the address is production's.

# --- Supabase: Project Settings > API, in the STAGING project -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://pnqjzlzcvrtkpzhonjft.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Kjm_lA_HSWQeO56HPgELmA_ehzuHTNs
SUPABASE_SERVICE_ROLE_KEY=

# --- The address links in emails point at (must not be the live site) -----------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:5001
NEXT_PUBLIC_APP_NAME=Food4Love (staging)

# --- Email (optional). A staging-only Resend key, and addresses you own ----------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=
SUPPORT_FROM_EMAIL=
ACCOUNT_UPDATES_FROM_EMAIL=
WELCOME_FROM_EMAIL=

# --- Scheduler test (any 32+ character test value; never the production one) ---------------------------
CRON_SECRET=

# --- Leave these EMPTY in staging unless you are deliberately testing them -------------------------------
RESEND_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
